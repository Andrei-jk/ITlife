{
  // данный файл ОЧЕНЬ рекомендуется создавать для каждого проекта, потому что именно в нем указывается точная папка ( "savePath": "./ITlife_css") для компилятора куда собирать скомпелированные файлы, потому что такая папка у каждого проекта своя
  "liveSassCompile.settings.formats": [
    {
      "format": "expanded",
      "extensionName": ".css",
      // ! в следующей строке указана ПАПКА в которую будут компилироваться файлы ИМЕННО ЭТОГО ПРОЕКТА и это значит, что для другого проекта этот путь надо заменить причем скомпилированные файлы (ITlife.css и ITlife.css.map ) компилятор создаст сам, надо только создать папку ITlife_css и указать путь "savePath": "./ITlife_css"
      "savePath": "~/ITlife_css"
      // "savePath": "~/CSS/"
    }
  ]
}